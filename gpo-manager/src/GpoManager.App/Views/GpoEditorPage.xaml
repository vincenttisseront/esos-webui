<Page
    x:Class="GpoManager.App.Views.GpoEditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GpoManager.Core.Models">

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Éditeur de paramètres GPO" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="Red"/>

        <Pivot Grid.Row="2">
            <PivotItem Header="Paramètres">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <ComboBox x:Name="GpoComboBox" Grid.Row="0" Width="400"
                              ItemsSource="{x:Bind ViewModel.Gpos, Mode=OneWay}"
                              SelectedItem="{x:Bind ViewModel.SelectedGpo, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              SelectionChanged="GpoComboBox_SelectionChanged"/>
                    <ListView Grid.Row="1" ItemsSource="{x:Bind ViewModel.Settings, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GpoSetting">
                                <Grid ColumnSpacing="8" Padding="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Name}"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Path}"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Value}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </PivotItem>

            <PivotItem Header="Recherche globale">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox Width="300" PlaceholderText="Rechercher un paramètre..."
                                 Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay}"/>
                        <Button Content="Rechercher" Command="{x:Bind ViewModel.SearchCommand}"/>
                    </StackPanel>
                    <ListView ItemsSource="{x:Bind ViewModel.SearchResults, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:GpoSetting">
                                <StackPanel Padding="4">
                                    <TextBlock Text="{x:Bind GpoDisplayName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Name}"/>
                                    <TextBlock Text="{x:Bind Value}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </PivotItem>
        </Pivot>

        <Expander Grid.Row="3" Header="Édition registre" IsExpanded="False">
            <StackPanel Spacing="8" MaxWidth="500">
                <ComboBox Header="Portée" SelectedIndex="0">
                    <ComboBoxItem Content="Ordinateur" Tag="Computer"/>
                    <ComboBoxItem Content="Utilisateur" Tag="User"/>
                </ComboBox>
                <TextBox Header="Chemin de clé" Text="{x:Bind ViewModel.RegistryKeyPath, Mode=TwoWay}"/>
                <TextBox Header="Nom de valeur" Text="{x:Bind ViewModel.RegistryValueName, Mode=TwoWay}"/>
                <TextBox Header="Valeur" Text="{x:Bind ViewModel.RegistryValue, Mode=TwoWay}"/>
                <Button Content="Enregistrer" Command="{x:Bind ViewModel.SaveRegistrySettingCommand}"/>
            </StackPanel>
        </Expander>
    </Grid>
</Page>
