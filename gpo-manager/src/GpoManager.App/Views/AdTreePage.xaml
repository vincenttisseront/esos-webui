<Page
    x:Class="GpoManager.App.Views.AdTreePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GpoManager.Core.Models">

    <Grid Padding="24" ColumnSpacing="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Spacing="12">
            <TextBlock Text="Arborescence Active Directory" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="Red"/>
            <Button Content="Actualiser" Command="{x:Bind ViewModel.LoadCommand}"/>

            <TreeView x:Name="OuTree" ItemsSource="{x:Bind ViewModel.DomainTree.Children, Mode=OneWay}"
                      SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="models:AdTreeNode">
                        <TextBlock Text="{x:Bind Name}"/>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </StackPanel>

        <StackPanel Grid.Column="1" Spacing="8">
            <TextBlock Text="GPO liés" Style="{ThemeResource SubtitleTextBlockStyle}"/>
            <ListView ItemsSource="{x:Bind ViewModel.SelectedNode.LinkedGpos, Mode=OneWay}">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:GpoLink">
                        <StackPanel Padding="4">
                            <TextBlock Text="{x:Bind GpoDisplayName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{x:Bind TargetDn}" FontSize="12" Opacity="0.7"/>
                            <TextBlock>
                                <Run Text="Ordre: "/>
                                <Run Text="{x:Bind Order}"/>
                                <Run Text=" | Activé: "/>
                                <Run Text="{x:Bind IsEnabled}"/>
                                <Run Text=" | Enforced: "/>
                                <Run Text="{x:Bind IsEnforced}"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
    </Grid>
</Page>
