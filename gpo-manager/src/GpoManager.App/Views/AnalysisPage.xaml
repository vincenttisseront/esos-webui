<Page
    x:Class="GpoManager.App.Views.AnalysisPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:GpoManager.Core.Models">

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <TextBlock Text="Centre d'analyse" Style="{ThemeResource TitleLargeTextBlockStyle}"/>
            <TextBlock Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}" Foreground="Red"/>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Lancer l'analyse" Command="{x:Bind ViewModel.RunAnalysisCommand}"/>
                <Button Content="Exporter HTML" Command="{x:Bind ViewModel.ExportHtmlCommand}"/>
                <Button Content="Exporter CSV" Command="{x:Bind ViewModel.ExportCsvCommand}"/>
            </StackPanel>

            <TextBlock Text="{x:Bind ViewModel.ExportPath, Mode=OneWay}" Opacity="0.7"/>

            <Pivot>
                <PivotItem Header="Duplications">
                    <ListView ItemsSource="{x:Bind ViewModel.Result.Duplicates, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DuplicateReport">
                                <StackPanel Padding="8">
                                    <TextBlock Text="{x:Bind SettingName}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Value}"/>
                                    <TextBlock Text="{x:Bind Scope}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>

                <PivotItem Header="Conflits">
                    <ListView ItemsSource="{x:Bind ViewModel.Result.Conflicts, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:ConflictReport">
                                <StackPanel Padding="8">
                                    <TextBlock Text="{x:Bind SettingName}" FontWeight="SemiBold" Foreground="DarkRed"/>
                                    <TextBlock Text="{x:Bind Scope}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>

                <PivotItem Header="Recommandations">
                    <ListView ItemsSource="{x:Bind ViewModel.Result.Suggestions, Mode=OneWay}">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:OptimizationSuggestion">
                                <StackPanel Padding="8">
                                    <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{x:Bind Description}" TextWrapping="WrapWholeWords"/>
                                    <TextBlock Text="{x:Bind Severity}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
            </Pivot>
        </StackPanel>
    </ScrollViewer>
</Page>
