<Window
    x:Class="GpoManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:GpoManager.App.Views">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Height="48" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <TextBlock Text="GPO Manager" VerticalAlignment="Center" Margin="16,0,0,0"
                       Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold"/>
        </Grid>

        <NavigationView x:Name="RootNavigation" Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        PaneDisplayMode="Left"
                        SelectionChanged="NavigationView_SelectionChanged"
                        IsSettingsVisible="False">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Tableau de bord" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Home"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Connexion" Tag="Connection">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Globe"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Liste GPO" Tag="GpoList">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="List"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Arborescence AD" Tag="AdTree">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Library"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Analyse" Tag="Analysis">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="ReportHacked"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Éditeur" Tag="Editor">
                    <NavigationViewItem.Icon>
                        <SymbolIcon Symbol="Edit"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
