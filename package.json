{
  "name": "esos-webui",
  "version": "1.0.9",
  "private": true,
  "description": "ESOS WebUI — web administration console for ESOS SAN storage",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "vue-i18n": "^11.4.2"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/copy-native-server-deps.mjs",
    "preview": "nuxt preview",
    "start": "node .output/server/index.mjs",
    "test": "vitest run",
    "test:rbac": "vitest run tests/api-rbac.test.ts",
    "test:san-query": "vitest run tests/san-query.test.ts",
    "test:watch": "vitest",
    "audit:theme": "node scripts/audit-theme.mjs",
    "smoke:output": "node scripts/batch3a-smoke.mjs",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.3",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vue/devtools-api": "^8.1.5",
    "@vueuse/core": "^15.0.0",
    "@vueuse/nuxt": "^15.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "chart.js": "^4.5.1",
    "dagre": "^0.8.5",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "jose": "^6.2.12",
    "ldapjs": "^3.0.7",
    "mysql2": "^3.24.5",
    "nuxt": "^4.6.0",
    "openid-client": "^6.8.8",
    "pg": "^8.23.1",
    "pinia": "^4.0.3",
    "ssh2": "^1.17.0",
    "vue": "^3.5.43",
    "vue-chartjs": "^5.3.4",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/dagre": "^0.7.54",
    "@types/ldapjs": "^3.0.6",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/ssh2": "^1.15.6",
    "@vue/test-utils": "^2.5.1",
    "commander": "^15.0.0",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.14.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "argon2@0.45.1": true,
    "cpu-features@0.0.10": true,
    "ssh2@1.17.0": true
  }
}
