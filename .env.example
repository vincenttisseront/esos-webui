# .env.example — Copy to .env and fill the values. NEVER commit .env.

# ─── SSH (single persistent TCP connection multiplexed by SSHSessionManager) ──
NUXT_SSH_HOST=
NUXT_SSH_PORT=22
NUXT_SSH_USER=

# Authentication — pick one of the following:
#  A) Private key file path (Docker mount-friendly, default).
NUXT_SSH_KEY_PATH=/app/keys/esos_rsa
#  B) Base64-encoded private key in env (avoids on-disk key in some setups).
#     Generate with: base64 -w0 ~/.ssh/id_esos
# NUXT_SSH_PRIVATE_KEY=
#  C) Password fallback (not recommended).
# NUXT_SSH_PASSWORD=

# ─── SCST source paths (override only if your ESOS deviates from defaults) ────
SCST_CONF_PATH=/etc/scst.conf
SCST_SYSFS_PATH=/sys/kernel/scst_tgt

# ─── Application ──────────────────────────────────────────────────────────────
NUXT_PORT=3000
NUXT_HOST=0.0.0.0
NODE_ENV=production

# ─── Persistance multi-SAN (SDD v2.0) ─────────────────────────────────────────
# Chemin SQLite (volume Docker `db-data` monté sur /app/data).
DB_PATH=/app/data/esos-webui.db

# Clé maître AES-256-GCM pour chiffrer les credentials SSH en BDD.
# OBLIGATOIRE dès qu'au moins un SAN est déclaré via l'UI admin.
# Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Si vous changez cette clé, les credentials existants deviennent illisibles.
NUXT_ENCRYPTION_KEY=

# ─── Authentification locale (SDD v2.1) ───────────────────────────────────────
# Secret HMAC pour signer les JWT de session (32 caractères minimum).
# Générer avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️ Si vous changez ce secret, toutes les sessions actives sont invalidées.
NUXT_JWT_SECRET=

# Optionnel : pepper dédié pour hacher state/nonce OIDC en base (sinon dérivé de NUXT_JWT_SECRET).
# NUXT_OIDC_STATE_PEPPER=

# Mettre à false si l'app est exposée en HTTP (pas HTTPS).
# Par défaut true en production (cookie Secure).
NUXT_COOKIE_SECURE=false

# ─── GitHub API (releases / tags — server-side only) ─────────────────────────
# Token optionnel pour augmenter le quota API (releases ESOS).
NUXT_GITHUB_TOKEN=
# TTL cache GitHub en ms (défaut 6h = 21600000).
# NUXT_GITHUB_CACHE_TTL_MS=21600000
# Logs cache serveur : NUXT_DEBUG_CACHE=1

# ─── Polling client (intervalles en ms) ───────────────────────────────────────
# Statut SSH global (défaut 30000). Minimum 10000.
NUXT_PUBLIC_SSH_STATUS_POLL_MS=30000
