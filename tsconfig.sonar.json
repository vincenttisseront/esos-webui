{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "~/*": ["./*"],
      "@/*": ["./*"],
      "~~/*": ["./*"],
      "@@/*": ["./*"]
    }
  },
  "include": [
    "components/**/*.ts",
    "components/**/*.vue",
    "composables/**/*.ts",
    "layouts/**/*.vue",
    "middleware/**/*.ts",
    "pages/**/*.vue",
    "plugins/**/*.ts",
    "server/**/*.ts",
    "stores/**/*.ts",
    "utils/**/*.ts",
    "types/**/*.ts",
    "shared/**/*.ts",
    "app.vue",
    "nuxt.config.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".nuxt",
    ".output",
    "dist",
    "coverage",
    "keys",
    ".secrets",
    "public"
  ]
}
